{
  "_comment": "//Copyright ANuj Nautiyal",
  "uid": "rate-limiting-local",
  "title": "Local rate limiting",
  "schemaVersion": 41,
  "version": 1,
  "tags": ["local", "rate-limiting"],
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "links": [{"title": "Explore traces in Tempo", "url": "/explore", "type": "link"}],
  "panels": [
    {
      "id": 1, "title": "Application scrape status", "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"rate-limiting-demo\"}", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 2, "title": "HTTP requests per second", "type": "timeseries",
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"rate-limiting-demo\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{uri}} {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 3, "title": "HTTP p95 latency", "type": "timeseries",
      "gridPos": {"x": 15, "y": 0, "w": 9, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"rate-limiting-demo\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "{{uri}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 4, "title": "Quota decisions per second (REST and MCP)", "type": "timeseries",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (policy, outcome) (rate(app_rate_limit_decisions_total{job=\"rate-limiting-demo\"}[$__rate_interval]))", "legendFormat": "{{policy}} {{outcome}}"}]
    },
    {
      "id": 5, "title": "Active circuit states", "type": "table",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "app_circuit_state{job=\"rate-limiting-demo\"} == 1", "instant": true, "format": "table"}]
    },
    {
      "id": 6, "title": "JVM heap used", "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"rate-limiting-demo\",area=\"heap\"})"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 7, "title": "Process CPU usage", "type": "timeseries",
      "gridPos": {"x": 8, "y": 12, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "process_cpu_usage{job=\"rate-limiting-demo\"}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 8, "title": "Database pool active connections", "type": "timeseries",
      "gridPos": {"x": 16, "y": 12, "w": 8, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "hikaricp_connections_active{job=\"rate-limiting-demo\"}", "legendFormat": "{{pool}}"}]
    }
  ]
}
